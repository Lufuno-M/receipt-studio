{
  "id": "amazon",
  "name": "Amazon",
  "sub": "Order confirmation",
  "category": "market",
  "initial": "A",
  "logo": "",
  "fields": [
    { "section": "Customer" },
    { "id": "name",      "label": "Name",          "default": "John Smith" },
    { "id": "order",     "label": "Order Number",  "default": "112-3456789-0123456" },
    { "id": "date",      "label": "Order Date",    "default": "June 28, 2024" },
    { "section": "Item" },
    { "id": "product",   "label": "Product Name",  "default": "Apple AirPods Pro (2nd Generation)" },
    { "id": "sold",      "label": "Sold by / Fulfilled by", "default": "Amazon.com" },
    { "id": "qty",       "label": "Qty",           "default": "1",          "width": "half" },
    { "id": "img",       "label": "Image URL",     "default": "",           "placeholder": "https://..." },
    { "section": "Pricing" },
    { "id": "price",     "label": "Item Price",    "default": "199",   "type": "number", "width": "half" },
    { "id": "ship",      "label": "Shipping",      "default": "0",     "type": "number", "width": "half" },
    { "id": "tax",       "label": "Tax",           "default": "15.92", "type": "number", "width": "half" },
    { "id": "disc",      "label": "Discount",      "default": "0",     "type": "number", "width": "half" },
    { "id": "_total",    "type": "total", "label": "Order Total" },
    { "section": "Delivery" },
    { "id": "saddr",     "label": "Ship To",       "default": "123 Main Street, Atlanta, GA 30301" },
    { "id": "arr1",      "label": "Arrival From",  "default": "June 30, 2024", "width": "half" },
    { "id": "arr2",      "label": "Arrival To",    "default": "July 2, 2024",  "width": "half" },
    { "id": "paymethod", "label": "Payment",       "default": "Visa •••• 4521" }
  ]
}
